# docker-compose.prod.yml 용. 복사해서 .env.prod 로 쓰고 커밋하지 마세요.
MYSQL_ROOT_PASSWORD=change-me-root
DB_USERNAME=agency
DB_PASSWORD=change-me-db
# 32바이트 이상 임의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes
# 처음 기동 때 만들어지는 운영진 계정(admin)의 비밀번호
ADMIN_PASSWORD=change-me-admin
# 프론트 주소 (쉼표로 여러 개). WebSocket Origin 검사에도 쓰입니다
CORS_ALLOWED_ORIGIN_PATTERNS=https://agency.example.com
# GitHub Actions 로 올린 이미지 주소 (비우면 로컬 빌드)
BACKEND_IMAGE=
BACKEND_PORT=8080
